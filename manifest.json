{
  "manifest_version": 3,
  "name": "Miniblock",
  "version": "1.0.0",
  "description": "Minimal site blocker for staying focused",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Miniblock"
  }
}
